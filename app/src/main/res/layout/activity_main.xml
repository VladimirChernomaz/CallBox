<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/buttonSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙"
            android:textSize="22sp"
            android:textColor="@color/text_dim"
            android:padding="6dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="18dp">

            <View
                android:id="@+id/statusGlow"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/shape_glow" />

            <View
                android:id="@+id/statusDot"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:background="@drawable/shape_dot" />

        </FrameLayout>

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/text_dim"
            android:gravity="center"
            android:layout_marginBottom="36dp" />

        <Button
            android:id="@+id/buttonCall"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:text="📞"
            android:textSize="30sp"
            android:background="@drawable/circle_green"
            android:stateListAnimator="@null"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/incomingBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="36dp">

                <Button
                    android:id="@+id/buttonDecline"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:text="✕"
                    android:textSize="26sp"
                    android:background="@drawable/circle_red"
                    android:stateListAnimator="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/decline_label"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <Button
                    android:id="@+id/buttonAccept"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:text="📞"
                    android:textSize="26sp"
                    android:background="@drawable/circle_green"
                    android:stateListAnimator="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/accept_label"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/inCallBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="28dp">

                <Button
                    android:id="@+id/buttonMute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:paddingHorizontal="18dp"
                    android:text="@string/mute"
                    android:backgroundTint="#33FFFFFF"
                    android:textColor="@color/text_dark"
                    android:layout_marginEnd="10dp" />

                <Button
                    android:id="@+id/buttonSpeaker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:paddingHorizontal="18dp"
                    android:text="@string/speaker_off"
                    android:backgroundTint="#33FFFFFF"
                    android:textColor="@color/text_dark" />

            </LinearLayout>

            <Button
                android:id="@+id/buttonHangup"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:text="✕"
                android:textSize="30sp"
                android:background="@drawable/circle_red"
                android:stateListAnimator="@null" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
